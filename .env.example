# Multi-Agent Tech Reporter Configuration
# Copy this file to .env and adjust variables as needed.

# LLM Provider: 'auto', 'gemini', 'openai', or 'mock'
# 'auto' selects gemini if GEMINI_API_KEY is present, openai if OPENAI_API_KEY is present, else mock.
LLM_PROVIDER=auto

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (or OpenAI-compatible, e.g., Ollama / vLLM / Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Search Tool Configuration ('duckduckgo', 'wikipedia', or 'mock')
SEARCH_BACKEND=duckduckgo

# Output Configuration
OUTPUT_DIR=outputs
REPORT_FORMAT=all
LOG_LEVEL=INFO
